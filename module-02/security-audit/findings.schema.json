{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pairroom.invalid/schemas/security-audit-run.json",
  "title": "PairRoom sanitized security audit run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_kind", "live_audit", "started_at", "scope", "provenance", "deterministic_scanner", "model_review", "human_validation", "overall_status"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^AUDIT-[0-9]{8}-[0-9]{3}$"},
    "run_kind": {"enum": ["sanitized_baseline", "recurring_audit"]},
    "live_audit": {"const": false},
    "started_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "files", "limitations"],
      "properties": {
        "target": {"const": "Module 4 PairRoom incident responder boundary"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_state", "scanner_source", "policy_source", "model_provenance"],
      "properties": {
        "repository_state": {"type": "string"},
        "scanner_source": {"type": "string"},
        "policy_source": {"type": "string"},
        "model_provenance": {"type": "string"}
      }
    },
    "deterministic_scanner": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "tool", "version", "command", "status", "checks", "findings"],
      "properties": {
        "stage": {"const": "deterministic_scanner"},
        "tool": {"type": "string"},
        "version": {"type": "string"},
        "command": {"type": "string"},
        "status": {"enum": ["completed", "not_run", "failed"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "model_review": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "status", "provider", "model_id", "configuration_ref", "analysis", "findings"],
      "properties": {
        "stage": {"const": "model_review"},
        "status": {"enum": ["completed", "not_run", "failed"]},
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "configuration_ref": {"type": "string"},
        "analysis": {"type": "array", "items": {"type": "string"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "human_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "status", "reviewer", "dispositions"],
      "properties": {
        "stage": {"const": "human_validation"},
        "status": {"enum": ["pending", "completed"]},
        "reviewer": {"type": ["string", "null"]},
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["finding_id", "disposition", "rationale", "reviewer"],
            "properties": {
              "finding_id": {"type": "string"},
              "disposition": {"enum": ["pending", "accepted", "rejected", "deferred", "not_applicable"]},
              "rationale": {"type": "string", "minLength": 1},
              "reviewer": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "overall_status": {"enum": ["pending_human_validation", "complete", "incomplete"]}
  },
  "$defs": {
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "title", "description", "recommendation"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^AUD-RESP-[0-9]{3}$"},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "title": {"type": "string", "maxLength": 180},
        "description": {"type": "string", "maxLength": 1200},
        "recommendation": {"type": "string", "maxLength": 1200},
        "source_rule": {"type": "string"},
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "result", "summary"],
      "properties": {
        "rule_id": {"type": "string"},
        "result": {"enum": ["pass", "fail", "not_applicable"]},
        "summary": {"type": "string", "maxLength": 500}
      }
    }
  }
}
