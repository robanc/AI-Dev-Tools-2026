{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pairroom.invalid/schemas/incident-response.json",
  "title": "PairRoom incident responder result",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "deployed_version", "user_impact", "evidence", "model", "proposed_action", "policy_decision", "recovery_verification", "escalation"],
  "properties": {
    "incident_id": {"type": "string", "pattern": "^INC-[0-9]{4}-[0-9]{3}$"},
    "deployed_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "user_impact": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "window", "http_5xx_count", "request_count"],
      "properties": {
        "summary": {"type": "string", "maxLength": 500},
        "window": {"type": "string", "maxLength": 20},
        "http_5xx_count": {"type": "number", "minimum": 0},
        "request_count": {"type": "number", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["metrics", "logs", "traces", "collection_status", "collection_errors"],
      "properties": {
        "metrics": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["service_name", "deployment_environment_name", "service_version", "http_route", "http_response_status_code", "request_count_5m"],
          "properties": {
            "service_name": {"const": "pairroom-backend"},
            "deployment_environment_name": {"enum": ["local", "development", "production", "unknown"]},
            "service_version": {"type": "string", "maxLength": 80},
            "http_route": {"type": "string", "maxLength": 140},
            "http_response_status_code": {"type": "string", "pattern": "^(|[1-5][0-9]{2})$"},
            "request_count_5m": {"type": "number", "minimum": 0}
          }
        }},
        "logs": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["event", "service_name", "deployment_environment_name", "service_version", "http_route", "http_response_status_code"],
          "properties": {
            "event": {"enum": ["http.request.completed", "session.created", "session.creation.failed"]},
            "service_name": {"const": "pairroom-backend"},
            "deployment_environment_name": {"enum": ["local", "development", "production", "unknown"]},
            "service_version": {"type": "string", "maxLength": 80},
            "http_route": {"type": "string", "maxLength": 140},
            "http_response_status_code": {"type": "string", "pattern": "^(|[1-5][0-9]{2})$"},
            "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
          }
        }},
        "traces": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["trace_id", "status"],
          "properties": {
            "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "status": {"enum": ["retrieved", "unavailable"]}
          }
        }},
        "collection_status": {"enum": ["complete", "partial"]},
        "collection_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "configuration_ref"],
      "properties": {
        "provider": {"type": "string", "maxLength": 100},
        "model_id": {"type": "string", "maxLength": 160},
        "configuration_ref": {"type": "string", "maxLength": 200}
      }
    },
    "proposed_action": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "summary", "reasoning_summary"],
      "properties": {
        "type": {"enum": ["investigate", "rollback", "escalate"]},
        "summary": {"type": "string", "maxLength": 500},
        "reasoning_summary": {"type": "string", "maxLength": 2000}
      }
    },
    "policy_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": {"enum": ["allow", "require_operator", "operator_authorized", "deny"]},
        "reason": {"type": "string", "maxLength": 500}
      }
    },
    "recovery_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checks", "verified_at"],
      "properties": {
        "status": {"enum": ["not_attempted", "verified", "failed", "escalated"]},
        "checks": {"type": "array", "items": {"type": "object"}},
        "verified_at": {"type": ["string", "null"]}
      }
    },
    "escalation": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "status", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["none", "pending", "escalated", "resolved"]},
        "reason": {"type": "string", "maxLength": 500}
      }
    }
  }
}
